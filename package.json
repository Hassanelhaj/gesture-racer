{
  "name": "gesture-racer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Endless racing game steered by webcam hand gestures. 100% client-side.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "setup:assets": "node scripts/setup-assets.mjs",
    "predev": "npm run setup:assets",
    "dev": "vite",
    "prebuild": "npm run setup:assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "collect": "npm run setup:assets && vite --open /ml/collect.html"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.0",
    "onnxruntime-web": "^1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
